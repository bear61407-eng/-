<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>學校生涯模擬器</title>
    <style>
        body {
            background-color: #0f172a;
            color: #f1f5f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        h1 {
            text-align: center;
            color: #38bdf8;
            border-bottom: 2px solid #38bdf8;
            padding-bottom: 10px;
        }
        .status-bar {
            background: #1e293b;
            padding: 12px 15px;
            border-radius: 8px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 20px;
            border: 1px solid #334155;
        }
        .game-box {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            padding: 20px;
            min-height: 180px;
            margin-bottom: 20px;
            line-height: 1.6;
        }
        .btn-container {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        button {
            background-color: #0284c7;
            color: #fff;
            border: none;
            padding: 12px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 16px;
            font-weight: bold;
            transition: 0.2s;
        }
        button:hover {
            background-color: #0369a1;
        }
        .log-text {
            color: #94a3b8;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>

    <h1>🏫 學校生涯模擬器</h1>
    
    <div class="status-bar">
        <div>📚 學業成績: <span id="study">60</span></div>
        <div>🌟 人際聲望: <span id="social">50</span></div>
        <div>⚡ 體力值: <span id="energy">100</span></div>
        <div>📅 當前進度: 第 <span id="week">1</span> 週</div>
    </div>

    <div class="game-box" id="game-text">
        鐘聲響起，新的一週又開始了。<br>
        作為學生，面對課業、社交與社團活動，你這週打算把重心放在哪裡？
    </div>

    <div class="btn-container" id="action-buttons">
        <button onclick="makeChoice('study')">專心準備考試（提升學業成績）</button>
        <button onclick="makeChoice('social')">參加社團與朋友混（提升人際聲望）</button>
        <button onclick="makeChoice('rest')">請假在家補眠（恢復體力值）</button>
    </div>

<script>
    let player = {
        study: 60,
        social: 50,
        energy: 100,
        week: 1
    };

    function updateUI() {
        document.getElementById("study").innerText = player.study;
        document.getElementById("social").innerText = player.social;
        document.getElementById("energy").innerText = player.energy;
        document.getElementById("week").innerText = player.week;
    }

    function makeChoice(type) {
        let eventText = "";
        
        if(type === 'study') {
            player.week++;
            player.study += 15;
            player.energy -= 20;
            player.social -= 5;
            eventText = `你這週花了很多時間在圖書館苦讀，雖然黑眼圈變深了，但考卷發下來時成績進步了不少！`;
        } else if(type === 'social') {
            player.week++;
            player.social += 15;
            player.energy -= 25;
            player.study -= 10;
            eventText = `你放學後跟同學們一起去逛街、打球，交到了不少好朋友，大家對你的評價大大提升！`;
        } else if(type === 'rest') {
            player.week++;
            player.energy = Math.min(100, player.energy + 30);
            player.study -= 5;
            eventText = `你決定這週好好放鬆、補足睡眠，精神總算恢復過來了，氣色好上許多。`;
        }

        // 檢查極端狀況或結局
        if(player.energy <= 0) {
            document.getElementById("game-text").innerHTML = `<h3>⚠️ 【模擬結束：體力透支】</h3><p>你因為過度拼搏導致體力不支，被迫請假休養了一段時間。校園生活總是需要勞逸結合的！</p>`;
            document.getElementById("action-buttons").innerHTML = `<button onclick="location.reload()">重新開始學期</button>`;
            return;
        }

        document.getElementById("game-text").innerHTML = `<p class="log-text"><b>【第 ${player.week - 1} 週結算】</b></p><p>${eventText}</p>`;
        updateUI();
    }
</script>

</body>
</html>
