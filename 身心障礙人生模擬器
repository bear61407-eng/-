<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>身障人生模擬器</title>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #2c3e50;
            color: #ecf0f1;
            max-width: 650px;
            margin: 30px auto;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        }
        h1 {
            text-align: center;
            color: #f1c40f;
            font-size: 1.8rem;
            margin-bottom: 5px;
        }
        .subtitle {
            text-align: center;
            color: #bdc3c7;
            font-size: 0.9rem;
            margin-bottom: 20px;
        }
        .stats-panel {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            background: #34495e;
            padding: 15px;
            border-radius: 8px;
            box-shadow: inset 0 2px 5px rgba(0,0,0,0.2);
            margin-bottom: 20px;
        }
        .stat-item {
            font-size: 0.95rem;
            font-weight: bold;
            color: #ecf0f1;
        }
        .game-box {
            background: #34495e;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 3px 12px rgba(0,0,0,0.2);
        }
        .story-text {
            font-size: 1.05rem;
            line-height: 1.6;
            margin-bottom: 20px;
            color: #ffffff;
        }
        .choices-container {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        button.choice-btn {
            background-color: #2980b9;
            color: white;
            border: none;
            padding: 12px 15px;
            border-radius: 6px;
            font-size: 1rem;
            cursor: pointer;
            text-align: left;
            transition: background-color 0.2s, transform 0.1s;
        }
        button.choice-btn:hover {
            background-color: #3498db;
            transform: translateY(-1px);
        }
        button.choice-btn:active {
            transform: translateY(0);
        }
        .log-box {
            margin-top: 20px;
            background: #1a252f;
            color: #bdc3c7;
            padding: 12px 15px;
            border-radius: 6px;
            font-size: 0.85rem;
            max-height: 150px;
            overflow-y: auto;
            border: 1px solid #4e6d8c;
        }
    </style>
</head>
<body>

    <h1>身障人生模擬器</h1>
    <div class="subtitle">一段關於勇氣、抗爭、時代與自我認同的生命旅程</div>

    <!-- 屬性面板 -->
    <div class="stats-panel" id="statsPanel">
        <div class="stat-item">階段：<span id="stageName">幼兒期</span></div>
        <div class="stat-item">抗壓韌性：<span id="resilience">10</span></div>
        <div class="stat-item">家庭羈絆：<span id="familyBond">10</span></div>
        <div class="stat-item">主體意識：<span id="identity">10</span></div>
    </div>

    <!-- 遊戲互動區 -->
    <div class="game-box">
        <div class="story-text" id="storyText">載入中...</div>
        <div class="choices-container" id="choicesContainer"></div>
    </div>

    <!-- 歷史紀錄 -->
    <div class="log-box" id="logBox">
        [系統] 生命軌跡初始化完成。5個多月大時診斷出腦性麻痺，7歲時確診癲癇。與奶奶在中和生活，就讀積穗國小。
    </div>

<script>
    // 遊戲狀態變數
    let player = {
        resilience: 10,
        familyBond: 10,
        identity: 10,
        choicesState: {}
    };

    // 更新介面數值
    function updateStats() {
        document.getElementById('resilience').innerText = player.resilience;
        document.getElementById('familyBond').innerText = player.familyBond;
        document.getElementById('identity').innerText = player.identity;
    }

    // 新增紀錄
    function addLog(text) {
        const logBox = document.getElementById('logBox');
        logBox.innerHTML += `<br>${text}`;
        logBox.scrollTop = logBox.scrollHeight;
    }

    // 渲染劇情與選項
    function renderScene(stageTitle, story, choices) {
        document.getElementById('stageName').innerText = stageTitle;
        document.getElementById('storyText').innerText = story;
        const container = document.getElementById('choicesContainer');
        container.innerHTML = '';

        choices.forEach(choice => {
            const btn = document.createElement('button');
            btn.className = 'choice-btn';
            btn.innerText = choice.text;
            btn.onclick = () => {
                choice.action();
                updateStats();
            };
            container.appendChild(btn);
        });
    }

    // 遊戲啟動：國小畢業階段
    function startGame() {
        updateStats();
        sceneElementaryGraduation();
    }

    // 事件 1：小學六年級畢業階段
    function sceneElementaryGraduation() {
        let story = "小學六年級的畢業季到了。你與奶奶住在中和、讀著積穗國小，這幾年雖然伴隨腦性麻痺與7歲發作的癲癇，但你努力適應了生活。面對即將到來的國中，你面臨了關鍵的抉擇：";
        let choices = [
            {
                text: "A：請假去看新學區，但畢業後與舊學區斷了聯繫",
                action: () => {
                    player.resilience += 2;
                    addLog("[抉擇] 選擇探訪新學區，切斷舊聯繫，獨立面對未知。");
                    player.choicesState.middleSchoolPath = 'break';
                    sceneMiddleSchoolBullying();
                }
            },
            {
                text: "B：畢業後一起升上直屬學區，但學校素質與環境普通",
                action: () => {
                    player.familyBond += 2;
                    addLog("[抉擇] 與同儕直升舊學區，延續熟悉的生活圈。");
                    player.choicesState.middleSchoolPath = 'direct';
                    sceneMiddleSchoolBullying();
                }
            },
            {
                text: "C：畢業後去讀新學校，且跟舊學區保持聯絡",
                action: () => {
                    player.resilience += 3;
                    player.familyBond += 1;
                    addLog("[抉擇] 轉往新學校，同時珍視並維持與舊學區的連結。");
                    player.choicesState.middleSchoolPath = 'keep_contact';
                    sceneMiddleSchoolBullying();
                }
            },
            {
                text: "D：畢業後去讀新學校，但跟舊學區從此斷聯",
                action: () => {
                    player.resilience += 4;
                    addLog("[抉擇] 徹底告別過去，前往全新環境重新開始。");
                    player.choicesState.middleSchoolPath = 'total_cutoff';
                    sceneMiddleSchoolBullying();
                }
            }
        ];
        renderScene("國小畢業與轉折", story, choices);
    }

    // 事件 2：國中階段的校園霸凌與應對態度
    function sceneMiddleSchoolBullying() {
        let path = player.choicesState.middleSchoolPath;
        let story = "國中階段如預期般遇到了校園霸凌。面對惡意與排擠，因著你先前不同的入學抉擇，你決定以什麼樣的態度去面對？";
        let choices = [
            {
                text: "A：選擇沉默隱忍與獨自承受，保護自己不惹事",
                action: () => {
                    player.resilience -= 2;
                    addLog("[霸凌] 選擇隱忍，內心默默承受壓力。");
                    player.choicesState.bullyAttitude = 'silent';
                    sceneParentResponse();
                }
            },
            {
                text: "B：激起強烈的防衛與反抗心，絕不向惡意低頭",
                action: () => {
                    player.resilience += 5;
                    player.identity += 3;
                    addLog("[霸凌] 選擇正面對抗，展現不屈的意志。");
                    player.choicesState.bullyAttitude = 'defiant';
                    sceneParentResponse();
                }
            }
        ];
        renderScene("國中階段：校園霸凌", story, choices);
    }

    // 事件 3：父母與師長面對霸凌的態度
    function sceneParentResponse() {
        let story = "霸凌事件爆發後，學校師長介入，而父母的反應與處理方式將決定這場風波的走向：";
        let choices = [
            {
                text: "A：爸媽與老師一起積極介入，陪著你一步步處理",
                action: () => {
                    player.familyBond += 5;
                    addLog("[家長反應] 父母與學校站在同一陣線，給予溫暖支持。");
                    sceneLinKouMove();
                }
            },
            {
                text: "B：爸媽給我器材與工具，教導我如何自己蒐集證據",
                action: () => {
                    player.resilience += 5;
                    player.identity += 3;
                    addLog("[家長反應] 父母培養你的獨立性，教你蒐證自保。");
                    sceneLinKouMove();
                }
            },
            {
                text: "C：父母基於現實考量，要你把事情壓下來、息事寧人",
                action: () => {
                    player.familyBond -= 4;
                    player.resilience -= 3;
                    addLog("[家長反應] 父母選擇息事寧人，讓你感到無奈與孤立。");
                    sceneLinKouMove();
                }
            },
            {
                text: "D：不理會學校，你自己去找媒體爆料、鬧上新聞",
                action: () => {
                    player.identity += 8;
                    player.resilience += 6;
                    addLog("[家長反應] 你直接對外爆料驚動媒體，父母態度轉為震驚與焦慮。");
                    sceneLinKouMove();
                }
            }
        ];
        renderScene("家庭與霸凌處理", story, choices);
    }

    // 事件 4：搬遷林口與國小同學喪禮
    function sceneLinKouMove() {
        let story = "國中時期，因為爸爸工作異動，全家搬到了林口（當時的林口還沒有機場捷運與環狀線，生活機能截然不同）。不久後，傳來了過去國小同學過世的消息，家長（爸爸、媽媽、阿公、阿嬤）基於擔憂與傳統觀念，反對你去參加喪禮……";
        let choices = [
            {
                text: "A：聽從長輩勸阻，乖乖留在家裡，不去參加喪禮",
                action: () => {
                    player.familyBond += 2;
                    addLog("[喪禮抉擇] 聽從長輩安排未出席，心中留下遺憾。");
                    sceneJuniorGraduation();
                }
            },
            {
                text: "B：堅持己見，排除萬難去送老同學最後一程，對家庭產生抗拒",
                action: () => {
                    player.familyBond -= 5;
                    player.resilience += 4;
                    addLog("[喪禮抉擇] 違背長輩意願出席，與家庭產生裂痕與疏離。");
                    sceneJuniorGraduation();
                }
            }
        ];
        renderScene("林口搬遷與告別", story, choices);
    }

    // 事件 5：國中畢業與升學取向
    function sceneJuniorGraduation() {
        let story = "國中畢業的十字路口。媽媽建議去彰化和美實驗學校（專為身障生設置的特教資源環境），但另一邊則是透過一般會考來選填普通學校，最後考上並只能選擇林口高中。你決定？";
        let choices = [
            {
                text: "A：聽從媽媽建議，前往彰化和美實驗學校就讀",
                action: () => {
                    player.familyBond += 3;
                    addLog("[升學抉擇] 選擇和美實驗學校，獲得完善特教資源。");
                    player.choicesState.highSchoolType = 'hemis';
                    sceneSocialMovements();
                }
            },
            {
                text: "B：參加會考選填，進入林口高中體系",
                action: () => {
                    player.resilience += 4;
                    player.identity += 4;
                    addLog("[升學抉擇] 挑戰體制，進入林口高中就讀。");
                    player.choicesState.highSchoolType = 'linkou';
                    sceneSocialMovements();
                }
            }
        ];
        renderScene("國中畢業與升學抉擇", story, choices);
    }

    // 事件 6：三年社運衝擊（太陽花、洪仲丘、反課綱）
    function sceneSocialMovements() {
        let story = "正值國高中交替的這三年，台灣社會風起雲湧：三年內接連爆發了洪仲丘案、太陽花學運與反課綱爭議。這些巨大的社會震盪，深深形塑了你的政治立場與思想灌溉。";
        let choices = [
            {
                text: "C：全心投入時代浪潮，關注台灣主體性與社會公義（點擊繼續）",
                action: () => {
                    player.identity += 10;
                    addLog("[時代洗禮] 經歷三年重大社運，台灣主體意識與獨立觀點在你心中扎根。");
                    sceneHighSchoolHistory();
                }
            }
        ];
        renderScene("時代浪潮：三年社運", story, choices);
    }

    // 事件 7：高一課綱與台灣史觀置換
    function sceneHighSchoolHistory() {
        let story = "進入高中後，你強烈強調台灣主體性及台灣獨立看法，但當時教科書仍是99課綱的史觀與文言文選文。你在心中或行動上做出改變：";
        let choices = [
            {
                text: "將課本上的中國史觀相關詞彙，自主替換成台灣史觀詞彙！",
                action: () => {
                    player.identity += 8;
                    addLog("[高一行動] 自主進行史觀轉換，鞏固對台灣主體性的堅定信仰。");
                    sceneHighSchoolSenior();
                }
            }
        ];
        renderScene("高一：史觀轉譯與認同", story, choices);
    }

    // 事件 8：高三林口高中訪問與表現
    function sceneHighSchoolSenior() {
        let story = "高二在林口順順度過。到了高中三年級，因為爸爸公司剛好要針對下一課綱白話文與文言文比例的問題，進到林口高中做訪問調查。此時你面臨了鏡頭與抉擇：";
        let choices = [
            {
                text: "A：保持低調，沉默以對，不願多作表態",
                action: () => {
                    player.resilience += 1;
                    addLog("[高三訪問] 選擇沉默以對，冷眼旁觀體制爭議。");
                    sceneUniversityChoice();
                }
            },
            {
                text: "B：積極上鏡頭與受訪，大聲表達你的立場與看法！",
                action: () => {
                    player.identity += 6;
                    player.resilience += 5;
                    addLog("[高三訪問] 積極站上鏡頭發聲，展現毫不畏懼的姿態。");
                    sceneUniversityChoice();
                }
            }
        ];
        renderScene("高三：課綱爭議與受訪抉擇", story, choices);
    }

    // 事件 9：大學入學抉擇
    function sceneUniversityChoice() {
        let story = "高中畢業的最終交叉口來臨。面對升學，你有兩條截然不同的道路可以選擇：";
        let choices = [
            {
                text: "A：報考身障考試，順利進入東吳大學哲學系",
                action: () => {
                    player.identity += 10;
                    addLog("[大學抉擇] 通過身障考試，踏入東吳哲學系探索深刻的思想與理性思辯。");
                    endGame("【哲學思辯之路】你以堅韌的意志與對台灣主體性的堅持，走進東吳哲學，展開充滿思索的大學人生！");
                }
            },
            {
                text: "B：透過學測管道，進入黎明科大或醒吾科大表演藝術系",
                action: () => {
                    player.resilience += 8;
                    player.identity += 6;
                    addLog("[大學抉擇] 選擇表演藝術系，在舞台上用身體與藝術展現生命力。");
                    endGame("【舞台生命力】你克服身體的障礙，在表演藝術的領域中綻放光芒，活出最自信的自我！");
                }
            }
        ];
        renderScene("大學抉擇：終章", story, choices);
    }

    // 遊戲結束結算
    let endGame = (resultTitle) => {
        let story = `【人生成就解鎖】\n\n${resultTitle}\n\n最終身障人生屬性結算：\n- 抗壓韌性：${player.resilience}\n- 家庭羈絆：${player.familyBond}\n- 主體意識：${player.identity}\n\n感謝你體驗這段充滿勇氣、時代衝擊與自我實現的生命旅程！`;
        let choices = [
            {
                text: "🔄 重新體驗另一種人生選擇",
                action: () => {
                    player = { resilience: 10, familyBond: 10, identity: 10, choicesState: {} };
                    document.getElementById('logBox').innerHTML = "[系統] 模擬器重新啟動。";
                    startGame();
                }
            }
        ];
        renderScene("人生軌跡總結", story, choices);
    }

    // 初始化執行
    startGame();
</script>

</body>
</html>
