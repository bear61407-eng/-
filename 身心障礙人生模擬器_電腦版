<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>身障人生模擬器 - 電腦版</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
            color: #ecf0f1;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 300px 1fr 300px;
            gap: 20px;
            height: calc(100vh - 40px);
        }

        /* ===== 左側面板：屬性與進度 ===== */
        .left-panel {
            background: rgba(44, 62, 80, 0.95);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            gap: 20px;
            overflow-y: auto;
        }

        .panel-title {
            color: #f1c40f;
            font-size: 1.2rem;
            font-weight: bold;
            border-bottom: 2px solid #f1c40f;
            padding-bottom: 10px;
        }

        .stats-group {
            background: #34495e;
            padding: 15px;
            border-radius: 8px;
            border-left: 4px solid #3498db;
        }

        .stat-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

        .stat-row:last-child {
            margin-bottom: 0;
        }

        .stat-label {
            color: #bdc3c7;
            font-weight: 500;
        }

        .stat-value {
            background: #2c3e50;
            color: #f1c40f;
            padding: 4px 10px;
            border-radius: 4px;
            font-weight: bold;
            min-width: 50px;
            text-align: center;
        }

        .stat-value.high {
            color: #2ecc71;
            background: rgba(46, 204, 113, 0.2);
        }

        .stat-value.low {
            color: #e74c3c;
            background: rgba(231, 76, 60, 0.2);
        }

        .progress-bar {
            width: 100%;
            height: 20px;
            background: #2c3e50;
            border-radius: 10px;
            overflow: hidden;
            margin-top: 8px;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #3498db, #2ecc71);
            transition: width 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 5px;
            font-size: 0.7rem;
            color: #fff;
        }

        /* ===== 中央面板：故事與選擇 ===== */
        .main-panel {
            background: rgba(44, 62, 80, 0.95);
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            gap: 20px;
            overflow-y: auto;
        }

        .stage-header {
            text-align: center;
            border-bottom: 3px solid #f1c40f;
            padding-bottom: 15px;
        }

        .stage-title {
            font-size: 2rem;
            color: #f1c40f;
            margin-bottom: 5px;
        }

        .stage-subtitle {
            color: #bdc3c7;
            font-size: 0.9rem;
        }

        .story-section {
            background: #34495e;
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid #2ecc71;
        }

        .story-text {
            font-size: 1.1rem;
            line-height: 1.8;
            color: #ffffff;
            white-space: pre-wrap;
        }

        .choices-section {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .choice-btn {
            background: linear-gradient(135deg, #2980b9, #3498db);
            color: white;
            border: none;
            padding: 16px 20px;
            border-radius: 8px;
            font-size: 1rem;
            cursor: pointer;
            text-align: left;
            transition: all 0.3s ease;
            font-weight: 500;
            box-shadow: 0 4px 12px rgba(41, 128, 185, 0.3);
        }

        .choice-btn:hover {
            background: linear-gradient(135deg, #3498db, #5dade2);
            transform: translateX(10px);
            box-shadow: 0 6px 20px rgba(41, 128, 185, 0.5);
        }

        .choice-btn:active {
            transform: translateX(8px);
        }

        /* ===== 右側面板：歷史記錄 ===== */
        .right-panel {
            background: rgba(44, 62, 80, 0.95);
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            gap: 15px;
            overflow-y: auto;
        }

        .log-box {
            background: #1a252f;
            color: #bdc3c7;
            padding: 15px;
            border-radius: 8px;
            font-size: 0.9rem;
            line-height: 1.6;
            border: 1px solid #4e6d8c;
            flex: 1;
            overflow-y: auto;
        }

        .log-entry {
            margin-bottom: 8px;
            padding-bottom: 8px;
            border-bottom: 1px solid #2c3e50;
        }

        .log-entry:last-child {
            border-bottom: none;
            margin-bottom: 0;
            padding-bottom: 0;
        }

        .log-entry.decision {
            color: #f39c12;
            font-weight: bold;
        }

        .log-entry.event {
            color: #3498db;
        }

        .log-entry.milestone {
            color: #2ecc71;
            font-weight: bold;
        }

        .reset-btn {
            background: linear-gradient(135deg, #e74c3c, #c0392b);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            font-size: 0.95rem;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .reset-btn:hover {
            background: linear-gradient(135deg, #c0392b, #a93226);
            transform: scale(1.05);
        }

        /* ===== 響應式設計 ===== */
        @media (max-width: 1200px) {
            .container {
                grid-template-columns: 250px 1fr 250px;
            }
        }

        @media (max-width: 768px) {
            .container {
                grid-template-columns: 1fr;
                height: auto;
            }

            .left-panel, .main-panel, .right-panel {
                height: auto;
                max-height: none;
            }
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #2c3e50;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb {
            background: #3498db;
            border-radius: 10px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #5dade2;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- 左側面板 -->
        <div class="left-panel">
            <div class="panel-title">📊 人生屬性</div>

            <div class="stats-group">
                <div class="stat-row">
                    <span class="stat-label">階段</span>
                    <span class="stat-value" id="stageName">幼兒期</span>
                </div>
            </div>

            <div class="stats-group">
                <div class="stat-row">
                    <span class="stat-label">抗壓韌性</span>
                    <span class="stat-value" id="resilience">10</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="resilienceBar" style="width: 50%;"></div>
                </div>
            </div>

            <div class="stats-group">
                <div class="stat-row">
                    <span class="stat-label">家庭羈絆</span>
                    <span class="stat-value" id="familyBond">10</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="familyBondBar" style="width: 50%;"></div>
                </div>
            </div>

            <div class="stats-group">
                <div class="stat-row">
                    <span class="stat-label">主體意識</span>
                    <span class="stat-value" id="identity">10</span>
                </div>
                <div class="progress-bar">
                    <div class="progress-fill" id="identityBar" style="width: 50%;"></div>
                </div>
            </div>

            <div class="panel-title" style="margin-top: 10px;">📜 統計</div>
            <div class="stats-group">
                <div class="stat-row">
                    <span class="stat-label">已做決定</span>
                    <span class="stat-value" id="decisionCount">0</span>
                </div>
                <div class="stat-row">
                    <span class="stat-label">故事進度</span>
                    <span class="stat-value" id="progressPercent">0%</span>
                </div>
            </div>
        </div>

        <!-- 中央面板 -->
        <div class="main-panel">
            <div class="stage-header">
                <div class="stage-title" id="storyTitle">身障人生模擬器</div>
                <div class="stage-subtitle">一段關於勇氣、抗爭、時代與自我認同的生命旅程</div>
            </div>

            <div class="story-section">
                <div class="story-text" id="storyText">載入中...</div>
            </div>

            <div class="choices-section" id="choicesContainer"></div>
        </div>

        <!-- 右側面板 -->
        <div class="right-panel">
            <div class="panel-title">📝 人生軌跡</div>
            <div class="log-box" id="logBox"></div>
            <button class="reset-btn" onclick="resetGame()">🔄 重新開始</button>
        </div>
    </div>

    <script>
        // 遊戲狀態變數
        let player = {
            resilience: 10,
            familyBond: 10,
            identity: 10,
            choicesState: {},
            decisionCount: 0,
            currentScene: 0
        };

        const MAX_STATS = 50;
        const TOTAL_SCENES = 9;

        // 初始化日誌
        function initLog() {
            const logBox = document.getElementById('logBox');
            logBox.innerHTML = '<div class="log-entry milestone">[系統] 生命軌跡初始化完成。</div>' +
                '<div class="log-entry event">身份：身心障礙者、腦性麻痺患者、癲癇患者</div>' +
                '<div class="log-entry event">年代：5個月大確診腦性麻痺，7歲確診癲癇</div>' +
                '<div class="log-entry event">地點：中和、與奶奶生活、就讀積穗國小</div>';
        }

        // 更新屬性與進度條
        function updateStats() {
            const resilience = Math.max(0, Math.min(player.resilience, MAX_STATS));
            const familyBond = Math.max(0, Math.min(player.familyBond, MAX_STATS));
            const identity = Math.max(0, Math.min(player.identity, MAX_STATS));

            document.getElementById('resilience').innerText = resilience;
            document.getElementById('familyBond').innerText = familyBond;
            document.getElementById('identity').innerText = identity;

            // 更新進度條
            document.getElementById('resilienceBar').style.width = (resilience / MAX_STATS * 100) + '%';
            document.getElementById('familyBondBar').style.width = (familyBond / MAX_STATS * 100) + '%';
            document.getElementById('identityBar').style.width = (identity / MAX_STATS * 100) + '%';

            // 更新統計
            document.getElementById('decisionCount').innerText = player.decisionCount;
            document.getElementById('progressPercent').innerText = Math.round((player.currentScene / TOTAL_SCENES) * 100) + '%';
        }

        // 新增日誌
        function addLog(text, type = 'event') {
            const logBox = document.getElementById('logBox');
            const entry = document.createElement('div');
            entry.className = `log-entry ${type}`;
            entry.innerText = text;
            logBox.appendChild(entry);
            logBox.scrollTop = logBox.scrollHeight;
        }

        // 渲染劇情與選項
        function renderScene(stageTitle, story, choices) {
            document.getElementById('storyTitle').innerText = stageTitle;
            document.getElementById('storyText').innerText = story;
            
            const container = document.getElementById('choicesContainer');
            container.innerHTML = '';

            choices.forEach((choice, index) => {
                const btn = document.createElement('button');
                btn.className = 'choice-btn';
                btn.innerText = choice.text;
                btn.onclick = () => {
                    player.decisionCount++;
                    choice.action();
                    updateStats();
                };
                container.appendChild(btn);
            });
        }

        // 遊戲啟動
        function startGame() {
            player.currentScene = 1;
            initLog();
            updateStats();
            sceneElementaryGraduation();
        }

        // ===== 遊戲場景 =====

        function sceneElementaryGraduation() {
            let story = "小學六年級的畢業季到了。你與奶奶住在中和、讀著積穗國小，這幾年雖然伴隨腦性麻痺與7歲發作的癲癇，但你努力適應了生活。面對即將到來的國中，你面臨了關鍵的抉擇：";
            let choices = [
                {
                    text: "A：請假去看新學區，但畢業後與舊學區斷了聯繫",
                    action: () => {
                        player.resilience += 2;
                        addLog("[抉擇] 選擇探訪新學區，切斷舊聯繫，獨立面對未知。", "decision");
                        player.choicesState.middleSchoolPath = 'break';
                        player.currentScene++;
                        sceneMiddleSchoolBullying();
                    }
                },
                {
                    text: "B：畢業後一起升上直屬學區，但學校素質與環境普通",
                    action: () => {
                        player.familyBond += 2;
                        addLog("[抉擇] 與同儕直升舊學區，延續熟悉的生活圈。", "decision");
                        player.choicesState.middleSchoolPath = 'direct';
                        player.currentScene++;
                        sceneMiddleSchoolBullying();
                    }
                },
                {
                    text: "C：畢業後去讀新學校，且跟舊學區保持聯絡",
                    action: () => {
                        player.resilience += 3;
                        player.familyBond += 1;
                        addLog("[抉擇] 轉往新學校，同時珍視並維持與舊學區的連結。", "decision");
                        player.choicesState.middleSchoolPath = 'keep_contact';
                        player.currentScene++;
                        sceneMiddleSchoolBullying();
                    }
                },
                {
                    text: "D：畢業後去讀新學校，但跟舊學區從此斷聯",
                    action: () => {
                        player.resilience += 4;
                        addLog("[抉擇] 徹底告別過去，前往全新環境重新開始。", "decision");
                        player.choicesState.middleSchoolPath = 'total_cutoff';
                        player.currentScene++;
                        sceneMiddleSchoolBullying();
                    }
                }
            ];
            renderScene("國小畢業與轉折", story, choices);
        }

        function sceneMiddleSchoolBullying() {
            let story = "國中階段如預期般遇到了校園霸凌。面對惡意與排擠，因著你先前不同的入學抉擇，你決定以什麼樣的態度去面對？";
            let choices = [
                {
                    text: "A：選擇沉默隱忍與獨自承受，保護自己不惹事",
                    action: () => {
                        player.resilience -= 2;
                        addLog("[霸凌] 選擇隱忍，內心默默承受壓力。", "event");
                        player.choicesState.bullyAttitude = 'silent';
                        player.currentScene++;
                        sceneParentResponse();
                    }
                },
                {
                    text: "B：激起強烈的防衛與反抗心，絕不向惡意低頭",
                    action: () => {
                        player.resilience += 5;
                        player.identity += 3;
                        addLog("[霸凌] 選擇正面對抗，展現不屈的意志。", "decision");
                        player.choicesState.bullyAttitude = 'defiant';
                        player.currentScene++;
                        sceneParentResponse();
                    }
                }
            ];
            renderScene("國中階段：校園霸凌", story, choices);
        }

        function sceneParentResponse() {
            let story = "霸凌事件爆發後，學校師長介入，而父母的反應與處理方式將決定這場風波的走向：";
            let choices = [
                {
                    text: "A：爸媽與老師一起積極介入，陪著你一步步處理",
                    action: () => {
                        player.familyBond += 5;
                        addLog("[家長反應] 父母與學校站在同一陣線，給予溫暖支持。", "event");
                        player.currentScene++;
                        sceneLinKouMove();
                    }
                },
                {
                    text: "B：爸媽給我器材與工具，教導我如何自己蒐集證據",
                    action: () => {
                        player.resilience += 5;
                        player.identity += 3;
                        addLog("[家長反應] 父母培養你的獨立性，教你蒐證自保。", "decision");
                        player.currentScene++;
                        sceneLinKouMove();
                    }
                },
                {
                    text: "C：父母基於現實考量，要你把事情壓下來、息事寧人",
                    action: () => {
                        player.familyBond -= 4;
                        player.resilience -= 3;
                        addLog("[家長反應] 父母選擇息事寧人，讓你感到無奈與孤立。", "event");
                        player.currentScene++;
                        sceneLinKouMove();
                    }
                },
                {
                    text: "D：不理會學校，你自己去找媒體爆料、鬧上新聞",
                    action: () => {
                        player.identity += 8;
                        player.resilience += 6;
                        addLog("[家長反應] 你直接對外爆料驚動媒體，父母態度轉為震驚與焦慮。", "decision");
                        player.currentScene++;
                        sceneLinKouMove();
                    }
                }
            ];
            renderScene("家庭與霸凌處理", story, choices);
        }

        function sceneLinKouMove() {
            let story = "國中時期，因為爸爸工作異動，全家搬到了林口（當時的林口還沒有機場捷運與環狀線，生活機能截然不同）。不久後，傳來了過去國小同學過世的消息，家長基於擔憂與傳統觀念，反對你去參加喪禮……";
            let choices = [
                {
                    text: "A：聽從長輩勸阻，乖乖留在家裡，不去參加喪禮",
                    action: () => {
                        player.familyBond += 2;
                        addLog("[喪禮抉擇] 聽從長輩安排未出席，心中留下遺憾。", "event");
                        player.currentScene++;
                        sceneJuniorGraduation();
                    }
                },
                {
                    text: "B：堅持己見，排除萬難去送老同學最後一程，對家庭產生抗拒",
                    action: () => {
                        player.familyBond -= 5;
                        player.resilience += 4;
                        addLog("[喪禮抉擇] 違背長輩意願出席，與家庭產生裂痕與疏離。", "decision");
                        player.currentScene++;
                        sceneJuniorGraduation();
                    }
                }
            ];
            renderScene("林口搬遷與告別", story, choices);
        }

        function sceneJuniorGraduation() {
            let story = "國中畢業的十字路口。媽媽建議去彰化和美實驗學校（專為身障生設置的特教資源環境），但另一邊則是透過一般會考來選填普通學校，最後考上並只能選擇林口高中。你決定？";
            let choices = [
                {
                    text: "A：聽從媽媽建議，前往彰化和美實驗學校就讀",
                    action: () => {
                        player.familyBond += 3;
                        addLog("[升學抉擇] 選擇和美實驗學校，獲得完善特教資源。", "event");
                        player.choicesState.highSchoolType = 'hemis';
                        player.currentScene++;
                        sceneSocialMovements();
                    }
                },
                {
                    text: "B：參加會考選填，進入林口高中體系",
                    action: () => {
                        player.resilience += 4;
                        player.identity += 4;
                        addLog("[升學抉擇] 挑戰體制，進入林口高中就讀。", "decision");
                        player.choicesState.highSchoolType = 'linkou';
                        player.currentScene++;
                        sceneSocialMovements();
                    }
                }
            ];
            renderScene("國中畢業與升學抉擇", story, choices);
        }

        function sceneSocialMovements() {
            let story = "正值國高中交替的這三年，台灣社會風起雲湧：三年內接連爆發了洪仲丘案、太陽花學運與反課綱爭議。這些巨大的社會震盪，深深形塑了你的政治立場與思想灌溉。";
            let choices = [
                {
                    text: "→ 全心投入時代浪潮，關注台灣主體性與社會公義（點擊繼續）",
                    action: () => {
                        player.identity += 10;
                        addLog("[時代洗禮] 經歷三年重大社運，台灣主體意識與獨立觀點在你心中扎根。", "milestone");
                        player.currentScene++;
                        sceneHighSchoolHistory();
                    }
                }
            ];
            renderScene("時代浪潮：三年社運", story, choices);
        }

        function sceneHighSchoolHistory() {
            let story = "進入高中後，你強烈強調台灣主體性及台灣獨立看法，但當時教科書仍是99課綱的史觀與文言文選文。你在心中或行動上做出改變：";
            let choices = [
                {
                    text: "→ 將課本上的中國史觀相關詞彙，自主替換成台灣史觀詞彙！",
                    action: () => {
                        player.identity += 8;
                        addLog("[高一行動] 自主進行史觀轉換，鞏固對台灣主體性的堅定信仰。", "decision");
                        player.currentScene++;
                        sceneHighSchoolSenior();
                    }
                }
            ];
            renderScene("高一：史觀轉譯與認同", story, choices);
        }

        function sceneHighSchoolSenior() {
            let story = "高二在林口順順度過。到了高中三年級，因為爸爸公司剛好要針對下一課綱白話文與文言文比例的問題，進到林口高中做訪問調查。此時你面臨了鏡頭與抉擇：";
            let choices = [
                {
                    text: "A：保持低調，沉默以對，不願多作表態",
                    action: () => {
                        player.resilience += 1;
                        addLog("[高三訪問] 選擇沉默以對，冷眼旁觀體制爭議。", "event");
                        player.currentScene++;
                        sceneUniversityChoice();
                    }
                },
                {
                    text: "B：積極上鏡頭與受訪，大聲表達你的立場與看法！",
                    action: () => {
                        player.identity += 6;
                        player.resilience += 5;
                        addLog("[高三訪問] 積極站上鏡頭發聲，展現毫不畏懼的姿態。", "decision");
                        player.currentScene++;
                        sceneUniversityChoice();
                    }
                }
            ];
            renderScene("高三：課綱爭議與受訪抉擇", story, choices);
        }

        function sceneUniversityChoice() {
            let story = "高中畢業的最終交叉口來臨。面對升學，你有兩條截然不同的道路可以選擇：";
            let choices = [
                {
                    text: "A：報考身障考試，順利進入東吳大學哲學系",
                    action: () => {
                        player.identity += 10;
                        addLog("[大學抉擇] 通過身障考試，踏入東吳哲學系探索深刻的思想與理性思辯。", "milestone");
                        player.currentScene++;
                        endGame("【哲學思辯之路】\n\n你以堅韌的意志與對台灣主體性的堅持，走進東吳哲學，展開充滿思索的大學人生！");
                    }
                },
                {
                    text: "B：透過學測管道，進入黎明科大或醒吾科大表演藝術系",
                    action: () => {
                        player.resilience += 8;
                        player.identity += 6;
                        addLog("[大學抉擇] 選擇表演藝術系，在舞台上用身體與藝術展現生命力。", "milestone");
                        player.currentScene++;
                        endGame("【舞台生命力】\n\n你克服身體的障礙，在表演藝術的領域中綻放光芒，活出最自信的自我！");
                    }
                }
            ];
            renderScene("大學抉擇：終章", story, choices);
        }

        function endGame(resultTitle) {
            const resilience = Math.max(0, Math.min(player.resilience, MAX_STATS));
            const familyBond = Math.max(0, Math.min(player.familyBond, MAX_STATS));
            const identity = Math.max(0, Math.min(player.identity, MAX_STATS));

            let story = `${resultTitle}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

【人生成就解鎖】

最終身障人生屬性結算：
• 抗壓韌性：${resilience}
• 家庭羈絆：${familyBond}
• 主體意識：${identity}

做出抉擇數：${player.decisionCount}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

感謝你體驗這段充滿勇氣、時代衝擊與自我實現的生命旅程！`;
            
            let choices = [
                {
                    text: "🔄 重新體驗另一種人生選擇",
                    action: () => {
                        resetGame();
                    }
                }
            ];
            renderScene("人生軌跡總結", story, choices);
            addLog("遊戲完成！感謝遊玩身障人生模擬器。", "milestone");
        }

        function resetGame() {
            player = { resilience: 10, familyBond: 10, identity: 10, choicesState: {}, decisionCount: 0, currentScene: 0 };
            document.getElementById('logBox').innerHTML = '';
            startGame();
        }

        // 初始化執行
        startGame();
    </script>
</body>
</html>
